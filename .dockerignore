# Git & Version Control
.git
.gitignore

# Dependencies (will be installed inside the build)
node_modules
web/node_modules
backend/node_modules

# Android Project & Gradle Build Artifacts (not needed in web/backend container)
android_app
.gradle
local.properties
*.apk
*.aab

# Local databases and backups (persistent volume is mounted at runtime in /app/backend/data)
backend/data/*.db
backend/data/backups/
backend/data/comprovantes/*
!backend/data/comprovantes/.gitkeep
mega12.db
*.db
*.sqlite
*.db-journal
backup_*.json

# Logs and scratch
logs
*.log
npm-debug.log*
yarn-debug.log*
scratch
.artifacts
.gemini
.agents

# IDE & OS files
.vscode
.idea
.DS_Store
Thumbs.db
